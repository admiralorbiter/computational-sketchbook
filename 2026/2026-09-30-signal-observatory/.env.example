# Signal Observatory Configuration
# Copy to .env and fill in values
#
# This project uses direct scraping (yt-dlp, web parsing, AT Protocol
# public endpoints) instead of official APIs. No API keys required.

# Data paths (defaults are fine for local use)
# DATA_DIR=./data
# RUNS_DIR=./runs

# Request behavior
# USER_AGENT=signal-observatory/0.1.0 (research; +https://github.com/you/signal-observatory)
# REQUEST_DELAY_SECONDS=1.0
