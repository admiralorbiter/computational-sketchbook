    "sample_rules": [
      { "combo": ["Program Administrator", "Completed", "Open"], "outcomes": ["Yes", "Yes", "Yes", "No", "No"] },
      { "combo": ["Program Administrator", "Completed", "Locked"], "outcomes": ["No", "No", "No", "No", "Yes"] },
      { "combo": ["School Staff", "Completed", "Open"], "outcomes": ["No", "No", "No", "Yes", "Yes"] },
      { "combo": ["Volunteer", "Completed", "Open"], "outcomes": ["No", "No", "No", "No", "Yes"] }
    ]
  },
