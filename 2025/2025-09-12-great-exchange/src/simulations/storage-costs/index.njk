            </div>
            
            <div class="control-group">
                <label for="meeting-probability">Meeting Probability</label>
                <input type="range" id="meeting-probability" min="0.1" max="0.4" value="0.25" step="0.05">
                <span id="meeting-probability-value">0.25</span>
            </div>
            
            <div class="control-group">
                <label for="barley-cost">Barley Storage Cost</label>
                <input type="range" id="barley-cost" min="1" max="5" value="1" step="1">
                <span id="barley-cost-value">1</span>
            </div>
            
            <div class="control-group">
                <label for="copper-cost">Copper Storage Cost</label>
                <input type="range" id="copper-cost" min="2" max="8" value="4" step="1">
                <span id="copper-cost-value">4</span>
            </div>
            
            <div class="control-group">
                <label for="wool-cost">Wool Storage Cost</label>
                <input type="range" id="wool-cost" min="5" max="15" value="9" step="1">
                <span id="wool-cost-value">9</span>
            </div>
        </div>

        <div class="simulation-visualization" id="simulation-visualization">
