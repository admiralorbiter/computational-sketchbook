<script>
// Initialize the emergence patterns simulation
document.addEventListener('DOMContentLoaded', function() {
    // Initialize simulation
    const simulation = new KiyotakiWrightSimulation({
        population: 15,
        meetingProbability: 0.25, // Slightly higher meeting probability
        storageCosts: [1, 4, 9], // Barley, Copper, Wool
        recognitionCost: 0.1, // Lower recognition cost to encourage trading
        convergenceThreshold: 0.8,
        maxIterations: 2000,
        speed: 10, // Faster simulation for testing
        simulationType: 'emergence-patterns' // This enables full money emergence
    });
    
    // Initialize visualization
    const visualization = new SimulationVisualization('simulation-visualization', simulation);
    
    // Set up control handlers
    setupControls(simulation, visualization);
    
    // Set up simulation controls
    setupSimulationControls(simulation, visualization);
    
    // Initialize additional charts
    initializeEmergenceCharts(simulation);
});

function setupControls(simulation, visualization) {
    // Population slider
    const populationSlider = document.getElementById('population-slider');
    const populationValue = document.getElementById('population-value');
    
    populationSlider.addEventListener('input', function() {
        const value = parseInt(this.value);
        populationValue.textContent = value;
        simulation.config.population = value;
        simulation.reset();
        simulation.initializeAgents();
    });
    
    // Meeting probability slider
    const meetingSlider = document.getElementById('meeting-probability');
    const meetingValue = document.getElementById('meeting-probability-value');
    
    meetingSlider.addEventListener('input', function() {
        const value = parseFloat(this.value);
        meetingValue.textContent = value;
        simulation.config.meetingProbability = value;
    });
    
    // Recognition cost slider
    const recognitionSlider = document.getElementById('recognition-cost');
    const recognitionValue = document.getElementById('recognition-cost-value');
    
    recognitionSlider.addEventListener('input', function() {
        const value = parseFloat(this.value);
        recognitionValue.textContent = value;
        simulation.config.recognitionCost = value;
    });
    
    // Convergence threshold slider
    const convergenceSlider = document.getElementById('convergence-threshold');
    const convergenceValue = document.getElementById('convergence-threshold-value');
    
    convergenceSlider.addEventListener('input', function() {
        const value = parseFloat(this.value);
        convergenceValue.textContent = value;
        simulation.config.convergenceThreshold = value;
    });
}

function setupSimulationControls(simulation, visualization) {
    // Start button
    document.getElementById('start-simulation').addEventListener('click', function() {
        simulation.start();
        this.disabled = true;
        document.getElementById('pause-simulation').disabled = false;
    });
    
    // Pause button
    document.getElementById('pause-simulation').addEventListener('click', function() {
        simulation.stop();
        this.disabled = true;
        document.getElementById('start-simulation').disabled = false;
    });
    
    // Reset button
    document.getElementById('reset-simulation').addEventListener('click', function() {
        simulation.reset();
        visualization.reset();
        updateResults(simulation);
    });
    
    // Update results periodically
    setInterval(() => {
        if (simulation.isRunning) {
            updateResults(simulation);
            visualization.update();
        }
    }, 1000);
}

function initializeEmergenceCharts(simulation) {
    // Initialize efficiency chart
    const efficiencyElement = document.getElementById('efficiency-chart');
    if (!efficiencyElement) return; // Skip if element doesn't exist
    
    const efficiencyCtx = efficiencyElement.getContext('2d');
    const efficiencyChart = new Chart(efficiencyCtx, {
        type: 'line',
        data: {
            labels: [],
            datasets: [{
                label: 'Efficiency',
                data: [],
                borderColor: '#4CAF50',
                backgroundColor: 'rgba(76, 175, 80, 0.1)',
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    max: 1
                }
            }
        }
    });
    
    // Initialize money usage chart
    const moneyUsageElement = document.getElementById('money-usage-chart');
    if (!moneyUsageElement) return; // Skip if element doesn't exist
    
    const moneyUsageCtx = moneyUsageElement.getContext('2d');
    const moneyUsageChart = new Chart(moneyUsageCtx, {
        type: 'doughnut',
        data: {
            labels: ['Barley', 'Copper Tools', 'Wool Textiles'],
            datasets: [{
                data: [0, 0, 0],
                backgroundColor: ['#D4AF37', '#B87333', '#8B4513']
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false
        }
    });
    
    // Store charts for updates
    window.efficiencyChart = efficiencyChart;
    window.moneyUsageChart = moneyUsageChart;
}

function updateResults(simulation) {
    const data = simulation.getSimulationData();
    
    // Update basic metrics
    document.getElementById('current-iteration').textContent = data.iteration;
    document.getElementById('total-trades').textContent = data.trades.length;
    document.getElementById('trading-efficiency').textContent = 
        (data.metrics.efficiency * 100).toFixed(1) + '%';
    document.getElementById('money-circulation').textContent = 
        (data.metrics.monetaryCirculation * 100).toFixed(1) + '%';
    document.getElementById('convergence-step').textContent = 
        data.metrics.convergenceStep || '-';
    document.getElementById('welfare-gain').textContent = 
        (data.metrics.welfareGain || 0).toFixed(1) + '%';
    
    // Update convergence progress
    const convergenceProgress = (data.metrics.monetaryCirculation / simulation.config.convergenceThreshold) * 100;
    document.getElementById('convergence-progress').style.width = Math.min(convergenceProgress, 100) + '%';
    document.getElementById('convergence-text').textContent = 
        Math.min(convergenceProgress, 100).toFixed(1) + '% converged';
    
    // Update charts
    updateEmergenceCharts(data);
}

function updateEmergenceCharts(data) {
    // Update efficiency chart
    if (window.efficiencyChart) {
        const recentData = data.trades.slice(-50);
        const efficiencyData = recentData.map((trade, index) => ({
            x: index,
            y: trade.successful ? 1 : 0
        }));
        
        window.efficiencyChart.data.labels = efficiencyData.map((_, i) => i);
        window.efficiencyChart.data.datasets[0].data = efficiencyData.map(d => d.y);
        window.efficiencyChart.update();
    }
    
    // Update money usage chart
    if (window.moneyUsageChart) {
        const recentTrades = data.trades.slice(-50);
        const moneyUsage = [0, 0, 0];
        
        recentTrades.forEach(trade => {
            if (trade.usedMoney) {
                if (trade.commodity1 === 0 || trade.commodity2 === 0) moneyUsage[0]++;
                if (trade.commodity1 === 1 || trade.commodity2 === 1) moneyUsage[1]++;
                if (trade.commodity1 === 2 || trade.commodity2 === 2) moneyUsage[2]++;
            }
        });
        
        window.moneyUsageChart.data.datasets[0].data = moneyUsage;
        window.moneyUsageChart.update();
    }
}
</script>
